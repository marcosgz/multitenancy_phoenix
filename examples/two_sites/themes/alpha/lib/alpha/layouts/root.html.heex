<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default={@current_site.settings["title"]}>
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/themes/alpha/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/themes/alpha/app.js"}>
    </script>
  </head>
  <body data-site={@current_site.slug}>
    {@inner_content}
  </body>
</html>
